# Configure SOMENTE este arquivo (copie para .env). Não altere nenhum outro arquivo do pacote:
# qualquer alteração bloqueia o portal.
# A conta de pagamento, as regras do evento e o prazo da LGPD já vêm definidos no pacote.

# Endereço público do site, com https e SEM barra no final
SITE_URL=https://eba.seudominio.com.br
# Porta interna (a mesma usada no nginx)
PORT=3006
# 127.0.0.1 com nginx na frente (recomendado)
HOST=127.0.0.1
# true se o domínio passa pelo Cloudflare; false se não passa
BEHIND_CLOUDFLARE=false

# E-mail que envia as confirmações (dados SMTP do provedor, ex.: Locaweb)
# Porta 587 → MAIL_SECURE=false | Porta 465 → MAIL_SECURE=true
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
# Remetente: a própria conta do MAIL_USER (ou um apelido autorizado nela)
MAIL_FROM="EBA Cuiabá Sul 2026 <conta@seudominio.com.br>"
